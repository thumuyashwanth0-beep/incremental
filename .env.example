# Postgres (docker compose default)
DATABASE_URL=postgres://jee:jee_dev_password@localhost:5432/jee

# Public base URL (used for origin checks and cookies)
APP_URL=http://localhost:3000

# --- AI (Anthropic Claude) ---
# Leave empty to disable AI features (the app still works: distractor diagnosis is AI-free).
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL=claude-opus-5
# Working analyses per user per day
AI_DAILY_LIMIT=30

# --- Content ---
# Serve auto-verified (AI-checked, not human-reviewed) questions in practice mode
PUBLISH_AUTO_VERIFIED=true
# Comma-separated sources allowed to be served. Add "nta" only after legal sign-off.
ALLOW_SOURCES=original,ai_generated,jeebench,pw25
