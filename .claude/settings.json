{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npm run content:validate)",
      "Bash(npm run content:coverage)",
      "Bash(npm run content:coverage:*)",
      "Bash(npm run content:import)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:migrate)",
      "Bash(docker compose ps)",
      "Bash(docker compose up -d db)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run build)",
      "Bash(npm run import:jeebench)",
      "Bash(npm run import:pw25)",
      "Bash(npm run content:generate:* --dry-run)",
      "Bash(npm run content:enrich:* --dry-run)"
    ],
    "ask": [
      "Bash(npm run content:generate:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(docker compose down:*)",
      "Bash(npm run content:enrich:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(npx drizzle-kit push:*)",
      "Bash(npx drizzle-kit drop:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-content.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
