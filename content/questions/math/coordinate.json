        {
          "key": "C",
          "text": "$(2, -3),\\ \\sqrt{10}$",
          "whyWrong": "Sign error on the constant: $r^2 = g^2 + f^2 - c = 4 + 9 + 3$."
        },
        {
          "key": "D",
          "text": "$(4, -6),\\ 4$",
