      "topicId": "math.sequences.ap-gp",
      "type": "single",
      "stem": "The sum of the first 20 terms of the arithmetic progression $3, 7, 11, \\ldots$ is",
      "options": [
        {
          "key": "A",
          "text": "$79$",
          "whyWrong": "That is the 20th *term*, not the sum."
