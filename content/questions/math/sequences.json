          "key": "C",
          "text": "$860$",
          "misconceptionId": "math.sequences.ap-gp.nd-instead-of-n-minus-1-d",
          "whyWrong": "Used $nd = 80$ instead of $(n-1)d = 76$."
        },
        {
          "key": "D",
          "text": "$1640$",
          "whyWrong": "Forgot the factor $\\tfrac{n}{2}$ (used $n$ instead)."
